# RAGFlow MCP endpoint
RAGFLOW_MCP_URL="http://172.28.21.22:9382/mcp/"
RAGFLOW_TOOL_NAME="ragflow_retrieval"

# Preferred: select dataset ids directly
RAGFLOW_DATASET_IDS=""

# Fallback: resolve dataset ids by content name from mcp_info.json
RAGFLOW_CONTENT="HWind"
RAGFLOW_MCP_INFO="mcp_info.json"

# Optional filters
RAGFLOW_DOCUMENT_IDS=""
RAGFLOW_TOP_N="8"

# Optional auth (self-host mode often does not require these)
RAGFLOW_AUTH_MODE="none"   # none | bearer | api_key
RAGFLOW_API_KEY=""
